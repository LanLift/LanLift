[Unit]
Description=LanLift private file transfer service (LAN host)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lanlift
Group=lanlift
EnvironmentFile=/etc/lanlift.env
ExecStart=/usr/bin/node /opt/lanlift/src/linux-host.js --port ${LANLIFT_PORT} --host ${LANLIFT_HOST} --receive-dir ${LANLIFT_RECEIVE_DIR} --session host --qr
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/lanlift

[Install]
WantedBy=multi-user.target
